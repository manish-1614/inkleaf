<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Modern Splash Screen Theme (Android 12+ / androidx.core:core-splashscreen) -->
    <style name="Theme.Inkleaf.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/inkleaf_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/inkleaf_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Inkleaf</item>
    </style>

    <!-- Post-Splash Application Theme -->
    <style name="Theme.Inkleaf" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F7F3E9</item>
    </style>
</resources>
